{
  "name": "aether-desktop",
  "version": "1.3.0",
  "private": true,
  "description": "The Electron shell of the Aether app: app:// serves the committed web/dist; main holds the bridge.",
  "type": "module",
  "main": "src/main/index.ts",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "typecheck": "../../node_modules/.bin/tsc -p tsconfig.json",
    "test": "node --test test/security/*.test.ts test/lifecycle/*.test.ts test/packaging/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "package": "node build/package.ts",
    "smoke": "node build/smoke.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "44.1.0",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "sax": "1.4.1",
    "argparse": "1.0.10"
  }
}
